#!/usr/bin/env bash
# commit-msg hook: reject AI-attribution patterns in commit messages.
#
# Enabled by running once per clone:
#     git config core.hooksPath .githooks
#
# See CLAUDE.md for the policy this enforces.

set -e

msg_file="$1"
msg="$(cat "$msg_file")"

# Strip git's own comment lines (those start with '#') before scanning.
scan="$(printf '%s\n' "$msg" | grep -v '^#')"

# Patterns that must not appear in any commit message, anywhere.
patterns=(
    '[Cc]laude.ai/code'
    'claude\.ai/code/session'
    'session_[0-9a-fA-F_]\{6,\}'
    'Co-[Aa]uthored-[Bb]y: *[Cc]laude'
    'Co-[Aa]uthored-[Bb]y: *.*@anthropic\.com'
    'Generated with .*[Cc]laude'
    'Generated by .*[Cc]laude'
    '🤖 *Generated'
    'noreply@anthropic\.com'
    '[Cc]reated (with|by) (an? )?(AI|LLM|assistant|[Cc]laude)'
)

fail=0
matched_pattern=""
matched_line=""

for p in "${patterns[@]}"; do
    if line="$(printf '%s\n' "$scan" | grep -E "$p" | head -1)"; then
        if [[ -n "$line" ]]; then
            fail=1
            matched_pattern="$p"
            matched_line="$line"
            break
        fi
    fi
done

if [[ $fail -eq 1 ]]; then
    cat >&2 <<EOF
commit-msg hook: rejected.

This repository forbids AI-attribution lines and session links in commit
messages (see CLAUDE.md).

Matched pattern: $matched_pattern
Offending line:  $matched_line

Edit the commit message and retry. Do NOT bypass with --no-verify.
EOF
    exit 1
fi

exit 0
